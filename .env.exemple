# Copier en .env et renseigner. Ce fichier ne doit JAMAIS être versionné.

# Signature des cookies de session. À générer : openssl rand -hex 32
# DOIT être fixe : régénéré à chaque démarrage, toutes les sessions tombent.
ADMIN_SECRET=

# Jeton de l'API Proxmox, rôle limité au cycle de vie d'un clone.
# Format : PVEAPIToken=orchestrator@pve!api=<secret>
PROXMOX_TOKEN=

PROXMOX_URL=https://10.0.20.1:8006/api2/json
VMID_MODELE=9002

# Dette du prototype : certificat Proxmox auto-signé.
# Sur le serveur physique, fournir le CA et remettre à 1.
NODE_TLS_REJECT_UNAUTHORIZED=1

# Dossier contenant les clés SSH des agents contraints.
CLES_SSH=/home/passerelle/.ssh
